---
// src/pages/idx-wrapper.astro
//
// IDX Broker Dynamic Wrapper template.
// IDX Broker fetches this page server-side and splices live MLS search/detail
// content between the <!--IDX-Wrapper-Start--> and <!--IDX-Wrapper-Stop--> sentinels.
//
// Verified against the canonical repo: matches the import style used in
// src/pages/index.astro (uses the @/ alias, not relative paths).

import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Search Sarasota & Bradenton MLS Listings | The Adamson Group";
const description = "Live Stellar MLS property search for Sarasota, Longboat Key, Lido Key, Siesta Key, St. Armands, Bird Key, and Lakewood Ranch. Powered by IDX Broker.";
---

<BaseLayout title={title} description={description}>
  <!-- FontAwesome 4 — IDX detail markup uses .fa fa-* (FA4); without it,
       gallery arrows, the heart, and sidebar-link icons render as tofu boxes. -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
        is:inline />
  <section class="section dark-section idx-wrapper-section">
    <div class="container">
      <div class="text-center mb-10">
        <p class="section-label text-[var(--color-cbgl-blue-light)] mb-3">
          Live MLS Search
        </p>
        <h1 class="font-display text-3xl md:text-4xl text-white mb-4 accent-underline-center">
          Sarasota & Barrier Islands Property Search
        </h1>
        <p class="text-white/60 text-sm max-w-2xl mx-auto">
          Real-time listings from Stellar MLS. Save searches, set alerts, and reach Ryan directly with any question on the homes that interest you.
        </p>
      </div>

      <!-- IDX Broker injects rendered listing/search/detail content between these two sentinels. -->
      <!-- Do NOT remove or modify the comments below. IDX's parser locates them by exact string. -->
      <div class="idx-wrapper-shell">
        <!--IDX-Wrapper-Start-->
        <div id="idxStart" style="display:none"></div>
        <noscript>
          <p class="text-white/70 text-center py-12">
            JavaScript is required to load live MLS listings. Please enable JavaScript or
            <a href="/contact" class="text-[var(--color-gold)] underline">contact Ryan directly</a>.
          </p>
        </noscript>
        <div class="idx-loading">
          <p class="text-white/50 text-sm font-accent uppercase tracking-[0.2em]">
            Loading live listings…
          </p>
        </div>
        <div id="idxStop" style="display:none"></div>
        <!--IDX-Wrapper-Stop-->
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* --------------------------------------------------------------------- */
  /* IDX Broker brand alignment                                            */
  /* IDX's modern widget renders lowercase .idx-* / BEM classes            */
  /* (.idx-details__price, .idx-text, .fa ...), NOT the legacy .IDX-*       */
  /* classes. We target the current markup and keep a few legacy           */
  /* fallbacks for any page still on the old renderer.                     */
  /* --------------------------------------------------------------------- */

  .idx-wrapper-section {
    min-height: 80vh;
    padding-top: 120px; /* clearance under fixed site header */
  }

  /* IDX content surface — LIGHT card.                                     */
  /* The modern IDX widget is designed for a light page. On the old dark   */
  /* shell its text inherited white from .dark-section and disappeared on  */
  /* IDX's own white cards. A real white card + dark ink fixes the         */
  /* "invisible description / blank feature tables" problem.               */
  .idx-wrapper-shell {
    background: #ffffff;
    color: #1a1a1a;
    border-radius: 12px;
    padding: clamp(1.25rem, 4vw, 3rem);
    min-height: 600px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }
  .idx-wrapper-shell a { color: var(--color-cbgl-blue, #0a2540); }
  .idx-wrapper-shell a:hover { color: var(--color-gold, #c9a961); }
  .idx-wrapper-shell h1, .idx-wrapper-shell h2,
  .idx-wrapper-shell h3, .idx-wrapper-shell h4,
  .idx-wrapper-shell strong {
    color: var(--color-cbgl-blue, #0a2540);
    font-family: var(--font-display, 'Playfair Display', Georgia, serif);
  }

  .idx-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  .idx-loading p { color: rgba(0, 0, 0, 0.45) !important; }

  /* Hide the loading message once IDX renders (new + legacy hooks) */
  .idx-wrapper-shell:has(.IDX-wrapper) .idx-loading,
  .idx-wrapper-shell:has(.IDX-resultsContainer) .idx-loading,
  .idx-wrapper-shell:has(.IDX-detailsBody) .idx-loading,
  .idx-wrapper-shell:has([class*="idx-details"]) .idx-loading,
  .idx-wrapper-shell:has([class*="idx-results"]) .idx-loading {
    display: none;
  }

  /* Price — kill the default IDX royal blue (new + legacy class names) */
  .idx-wrapper-shell .idx-details__price,
  .IDX-resultsPrice, .IDX-detailsPrice {
    color: var(--color-cbgl-blue, #0a2540) !important;
    font-weight: 700;
  }

  /* Icons (gallery arrows, heart, sidebar quick-links) in brand gold.     */
  /* Re-assert the icon font so nothing downstream swaps it back to Inter. */
  .idx-wrapper-shell .fa {
    color: var(--color-gold, #c9a961);
    font-family: 'FontAwesome' !important;
  }

  /* Primary buttons — gold pill (new markup + legacy) */
  .idx-wrapper-shell button,
  .idx-wrapper-shell input[type="submit"],
  .IDX-quicksearchSubmit, .IDX-detailsContactBtn, .IDX-btn-primary {
    background-color: var(--color-gold, #c9a961) !important;
    color: #000 !important;
    border: none !important;
    border-radius: 999px !important;
    font-weight: 600;
  }
  .idx-wrapper-shell button:hover,
  .idx-wrapper-shell input[type="submit"]:hover,
  .IDX-quicksearchSubmit:hover, .IDX-detailsContactBtn:hover {
    background-color: var(--color-gold-light, #d4b87a) !important;
  }

  /* Hide the generic ShareThis / AddThis social row (off-brand) */
  .idx-wrapper-shell .sharethis-inline-share-buttons,
  .idx-wrapper-shell .addthis_inline_share_toolbox {
    display: none !important;
  }

  /* Slim back-link injected on detail pages by the script below */
  .idx-back-link {
    display: inline-block;
    color: var(--color-gold, #c9a961);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .idx-back-link:hover { color: #fff; }

  /* Hide the GreatSchools widget/panel on detail pages (declutter).
     Leaves the basic MLS school-name fields in the facts table intact. */
  #IDX-detailsContainer-greatSchools,
  #IDX-panel-greatSchools,
  #IDX-panel-body-greatSchools,
  #GS_schoolSearchWidget,
  .idx-wrapper-shell iframe.greatschools {
    display: none !important;
  }

  /* ---- Mobile usability (declutter spacing, reclaim width, no overflow) ---- */
  @media (max-width: 640px) {
    .idx-wrapper-section {
      padding-top: 84px;   /* was a fixed 120px — too much dead space on phones */
      min-height: 0;       /* drop 80vh so short content doesn't leave a void */
    }
    .idx-wrapper-shell {
      padding: 1rem;       /* reclaim ~40px of content width vs desktop 48px */
      border-radius: 8px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
      overflow-x: hidden;  /* guard against wide IDX tables/maps */
    }
    /* keep all embedded media within the viewport */
    .idx-wrapper-shell img,
    .idx-wrapper-shell iframe,
    .idx-wrapper-shell table { max-width: 100%; }
    /* tame IDX's oversized 20px facts text on small screens */
    .idx-wrapper-shell .idx-text { font-size: 1rem; line-height: 1.35; }
  }

  /* MLS listing attribution kept for compliance but visually de-emphasized */
  .idx-attribution-min {
    font-size: 0.72rem !important;
    line-height: 1.4 !important;
    color: rgba(0, 0, 0, 0.45) !important;
  }
  .idx-attribution-min a { color: rgba(0, 0, 0, 0.5) !important; }

  /* ---- Funnel: no IDX visitor accounts; Home Platform instead ---- */
  .idx-wrapper-shell a[href*="/idx/userlogin"],
  .idx-wrapper-shell a[href*="/idx/usersignup"],
  .idx-wrapper-shell .IDX-signupLoginToggle { display:none !important; }
  .idx-hp-btn { display:inline-block; background:var(--color-cbgl-blue,#0a2540); color:#fff !important; border-radius:999px; padding:.45rem 1.1rem; font-weight:600; font-size:.85rem; text-decoration:none; }
  .idx-hp-btn:hover { background:var(--color-gold,#c9a961); color:#000 !important; }

  /* ---- Detail-page declutter ---- */
  .idx-wrapper-shell .IDX-similar-listings { display:none !important; }

  /* ---- Detail CTA panel (injected by script below) ---- */
  .idx-cta-panel { background:var(--color-cbgl-blue,#0a2540); border-radius:12px; padding:1.25rem 1.5rem; margin:1.25rem 0; display:flex; flex-wrap:wrap; gap:.75rem; align-items:center; }
  .idx-cta-panel .idx-cta-lead { color:#fff !important; font-weight:600; margin-right:auto; font-size:1rem; font-family:var(--font-display,Georgia,serif); }
  .idx-cta-btn { display:inline-block; border-radius:999px; padding:.7rem 1.4rem; font-weight:700; text-decoration:none; font-size:.95rem; }
  a.idx-cta-btn--gold { background:var(--color-gold,#c9a961); color:#000 !important; }
  a.idx-cta-btn--gold:hover { background:#d4b87a; color:#000 !important; }
  a.idx-cta-btn--ghost { border:1px solid rgba(255,255,255,.6); color:#fff !important; }
  a.idx-cta-btn--ghost:hover { border-color:var(--color-gold,#c9a961); color:var(--color-gold,#c9a961) !important; }
  .idx-cta-call { width:100%; color:rgba(255,255,255,.65) !important; font-size:.8rem; margin:0; }
  .idx-cta-call a { color:var(--color-gold,#c9a961) !important; }

  /* ---- Leads never enter IDX's CRM: their forms are hidden; ours replace them ---- */
  .idx-wrapper-shell form.IDX-contactForm,
  .idx-wrapper-shell .IDX-detailsContactBtn,
  .idx-wrapper-shell a[href*="/idx/moreinfo"] { display:none !important; }

  /* ---- Full property details collapsed behind a toggle ---- */
  .idx-fields-collapsed #IDX-fieldsWrapper { display:none; }

  /* ---- v3 declutter: Walk Score, AI Redesign, IDX nav links ---- */
  #IDX-walkscoreContainer, #ws-walkscore-tile,
  .idx-wrapper-shell iframe[src*="walkscore"] { display:none !important; }
  ai-redesign-widget, #ai-redesign-widget-idx, .ai-redesign-tool-launch { display:none !important; }

  /* ---- injected summary cells match IDX's own field styling ---- */
  .idx-field__ag .idx-label { display:block; }
  .idx-cta-panel--below { margin-top:1.5rem; }
  .idx-wrapper-shell button.idx-fields-toggle { display:block; width:100%; text-align:center; margin:1rem 0; padding:.7rem; border:1px dashed rgba(10,37,64,.35) !important; border-radius:10px !important; background-color:#fff !important; color:var(--color-cbgl-blue,#0a2540) !important; font-weight:600; cursor:pointer; }
  .idx-wrapper-shell button.idx-fields-toggle:hover { background-color:#f6f1e4 !important; }
</style>

<script is:inline>
  /* Detail-page context fixes. The wrapper is shared across all IDX routes,
     so the "Sarasota & Barrier Islands Property Search" hero also stamped
     onto single-listing pages. On /idx/details/* swap it for a back link,
     and prune the orphaned empty "No listings found" similar-listings box. */
  (function () {
    var isDetail = /\/idx\/details\//.test(location.pathname);

    if (isDetail) {
      var hero = document.querySelector('.idx-wrapper-section .text-center');
      if (hero) {
        hero.innerHTML =
          '<a href="#" class="idx-back-link">\u2190 Back to listings</a>';
        hero.classList.remove('mb-10');
        var bl = hero.querySelector('.idx-back-link');
        bl.addEventListener('click', function (e) {
          e.preventDefault();
          if (history.length > 1) history.back();
          else location.href = '/areas';
        });
      }
    }

    function pruneEmpty() {
      document.querySelectorAll('.idx-wrapper-shell *').forEach(function (el) {
        if (el.children.length === 0 &&
            /^\s*no listings found\s*$/i.test(el.textContent)) {
          var box = el.closest('section, div');
          if (box) box.style.display = 'none';
        }
      });
    }
    pruneEmpty();
    setTimeout(pruneEmpty, 1200);

    function minimizeAttribution() {
      var nodes = document.querySelectorAll('.idx-wrapper-shell div, .idx-wrapper-shell p');
      for (var i = 0; i < nodes.length; i++) {
        var own = '';
        for (var j = 0; j < nodes[i].childNodes.length; j++) {
          if (nodes[i].childNodes[j].nodeType === 3) own += nodes[i].childNodes[j].textContent;
        }
        if (/Listed by:/i.test(own)) { nodes[i].classList.add('idx-attribution-min'); break; }
      }
    }
    minimizeAttribution();
    setTimeout(minimizeAttribution, 1200); // IDX injects content asynchronously
  })();
</script>

<script is:inline>
  /* Funnel + declutter layer: hide IDX accounts (Home Platform instead),
     prominent showing/question CTAs, collapse the long field tables. */
  (function () {
    var isDetail = /\/idx\/details\//.test(location.pathname);

    function run() {
      var login = document.querySelector('.idx-wrapper-shell a[href*="/idx/userlogin"]');
      var navBar = login ? login.parentElement : null;
      if (navBar && !navBar.querySelector('.idx-hp-btn')) {
        var hp = document.createElement('a');
        hp.className = 'idx-hp-btn'; hp.href = '/home-platform';
        hp.textContent = 'Home Platform';
        navBar.appendChild(hp);
      }
      if (!isDetail) return;

      var m = location.pathname.match(/\/details\/listing\/[^/]+\/([^/]+)\/([^/?]+)/);
      var mls = m ? m[1] : '';
      var addr = m ? decodeURIComponent(m[2]).replace(/-/g, ' ').replace(/ FL \d{5}.*$/, '').trim() : '';
      var showUrl = '/request-showing?intent=showing&mls=' + encodeURIComponent(mls) + '&addr=' + encodeURIComponent(addr);
      var askUrl = '/request-showing?intent=question&mls=' + encodeURIComponent(mls) + '&addr=' + encodeURIComponent(addr);

      var head = document.getElementById('IDX-detailsHead');
      if (head && !document.querySelector('.idx-cta-panel')) {
        var p = document.createElement('div');
        p.className = 'idx-cta-panel';
        p.innerHTML =
          '<span class="idx-cta-lead">Like this home? See it in person.</span>' +
          '<a class="idx-cta-btn idx-cta-btn--gold" href="' + showUrl + '">Request a Showing</a>' +
          '<a class="idx-cta-btn idx-cta-btn--ghost" href="' + askUrl + '">Ask a Question</a>' +
          '<p class="idx-cta-call">or reach The Adamson Group directly: <a href="tel:+19417139234">(941) 713-9234</a></p>';
        head.parentNode.insertBefore(p, head.nextSibling);
      }

      var ss = document.getElementById('IDX-scheduleShowing');
      if (ss) { var sa = ss.tagName === 'A' ? ss : ss.querySelector('a'); if (sa) { sa.href = showUrl; sa.removeAttribute('onclick'); } }
      var mi = document.getElementById('IDX-moreinfo');
      if (mi) { var ma = mi.tagName === 'A' ? mi : mi.querySelector('a'); if (ma) { ma.href = askUrl; ma.removeAttribute('onclick'); } }

      document.querySelectorAll('.idx-wrapper-shell h2, .idx-wrapper-shell h3').forEach(function (h) {
        if (/^\s*Similar Listings\s*$/i.test(h.textContent)) h.style.display = 'none';
      });

      document.querySelectorAll('.idx-wrapper-shell button, .idx-wrapper-shell a, .idx-wrapper-shell span').forEach(function (el) {
        var txt = el.textContent.trim();
        if (txt === 'English' || txt === 'Espa\u00f1ol' || txt === 'Espanol') {
          var box = el.closest('div');
          if (box && box.textContent.trim().length < 30) box.style.display = 'none';
          else el.style.display = 'none';
        }
      });

      /* Full field tables stay hidden entirely (bare-minimum detail page);
         they remain in the DOM as the data source for the summary below. */
      var fw = document.getElementById('IDX-fieldsWrapper');
      if (fw) (fw.closest('.idx-wrapper-shell') || document.body).classList.add('idx-fields-collapsed');

      /* IDX nav links visitors don't need */
      document.querySelectorAll('.idx-wrapper-shell a').forEach(function (a) {
        var txt = a.textContent.trim();
        if (txt === 'New Search' || txt === 'My Account') a.style.display = 'none';
      });

      /* ---- Summary field rebuild: bare-minimum, buyer-question-first ---- */
      var right = document.querySelector('.idx-details__right');
      if (right && !right.getAttribute('data-ag-summary')) {
        right.setAttribute('data-ag-summary', '1');
        var cells = [].slice.call(right.querySelectorAll('.idx-field'));
        var byLabel = {};
        cells.forEach(function (c) {
          var l = c.querySelector('.idx-label');
          if (l) byLabel[l.textContent.trim()] = c;
        });
        ['County', 'Property Type'].forEach(function (l) {
          if (byLabel[l]) byLabel[l].style.display = 'none';
        });
        function fv(id, label) {
          var e = document.getElementById('IDX-field-' + id);
          if (!e) return null;
          var txt = e.textContent.replace(/\s+/g, ' ').trim();
          if (label && txt.toLowerCase().indexOf(label.toLowerCase()) === 0) txt = txt.slice(label.length).trim();
          return txt || null;
        }
        function cap(v) { return v === 'yes' ? 'Yes' : (v === 'no' ? 'No' : v); }
        function mk(label, val) {
          var d = document.createElement('div');
          d.className = 'idx-field idx-field__ag';
          var l = document.createElement('span'); l.className = 'idx-label'; l.textContent = label;
          var v = document.createElement('span'); v.className = 'idx-text'; v.textContent = val;
          d.appendChild(l); d.appendChild(v); return d;
        }
        function insAfter(node, ref) {
          if (ref && ref.parentNode) ref.parentNode.insertBefore(node, ref.nextSibling);
          else right.appendChild(node);
        }
        var priceEl = document.querySelector('.idx-details__price, .IDX-detailsPrice');
        var priceTxt = priceEl ? priceEl.textContent.trim().split('\n')[0].trim() : null;
        var priceNum = priceTxt ? parseFloat(priceTxt.replace(/[^0-9.]/g, '')) : null;
        var sqftCell = byLabel['SqFt'];
        var sqftNum = sqftCell ? parseFloat(sqftCell.textContent.replace(/[^0-9]/g, '')) : null;
        var ppsf = (priceNum && sqftNum) ? '$' + Math.round(priceNum / sqftNum).toLocaleString() : null;
        var anchor2 = sqftCell;
        var garage = fv('garageSpaces', 'Garage Spaces');
        if (garage && sqftCell) { var gc = mk('Garage Size', garage + (garage === '1' ? ' bay' : ' bays')); insAfter(gc, sqftCell); }
        var acresCell = byLabel['Acres'];
        var flood = fv('floodZoneCode', 'Flood Zone Code');
        if (flood) insAfter(mk('Flood Zone', flood), acresCell || sqftCell);
        var tail = byLabel['Property Sub Type'] || cells[cells.length - 1];
        var monthly = fv('totalMonthlyFees', 'Total Monthly Fees');
        var seq = [
          ['Pool Private', cap(fv('poolPrivateYN', 'Pool Private'))],
          ['Levels', fv('levels', 'Levels')],
          ['Water View', cap(fv('waterViewYN', 'Water View'))],
          ['Water View Type', fv('waterView', 'Water View Type')],
          ['Waterfront', cap(fv('waterfrontYN', 'Waterfront'))],
          ['Waterfront Features', fv('waterfrontFeatures', 'Waterfront Features')],
          ['Association Fee Requirement', fv('associationFeeRequirement', 'Association Fee Requirement')],
          ['Total Monthly Fees', monthly ? ('$' + monthly + ' / mo') : null],
          ['Price', priceTxt],
          ['Price Per SqFt', ppsf]
        ];
        seq.forEach(function (pair) {
          if (pair[1]) { var c2 = mk(pair[0], pair[1]); insAfter(c2, tail); tail = c2; }
        });
        /* Second CTA row directly below the summary */
        var basePanel = document.querySelector('.idx-cta-panel');
        if (basePanel && !document.querySelector('.idx-cta-panel--below')) {
          var p2 = basePanel.cloneNode(true);
          p2.classList.add('idx-cta-panel--below');
          var leadEl = p2.querySelector('.idx-cta-lead');
          if (leadEl) leadEl.textContent = 'Questions on this property? Straight answers, fast.';
          insAfter(p2, tail);
        }
      }
    }
    /* Backstop: any IDX-native form that slips past the CSS gets re-routed
       into our own lead pipeline instead of IDX Broker's CRM. */
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (!f || !f.matches) return;
      if (!f.matches('form.IDX-contactForm, form[action*="idxbroker.com"], form[id^="IDX-"]')) return;
      e.preventDefault(); e.stopImmediatePropagation();
      var val = function (sel) { var el = f.querySelector(sel); return el ? el.value : ''; };
      var fields = {};
      f.querySelectorAll('input[name], textarea[name], select[name]').forEach(function (el) {
        if (el.type !== 'hidden' && el.name !== 'bot-field' && el.value) fields[el.name] = el.value.slice(0, 300);
      });
      var name = val('input[name*="ame"]') || fields.name || '';
      var email = val('input[type="email"], input[name*="mail"]') || '';
      var phone = val('input[type="tel"], input[name*="hone"]') || '';
      var noteBits = [];
      Object.keys(fields).forEach(function (k) {
        if (!/ame$|mail|hone/i.test(k)) noteBits.push(k + ': ' + fields[k]);
      });
      noteBits.push('Source: IDX-native form intercepted on ' + location.pathname);
      fetch('/.netlify/functions/community-lead', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, email: email, phone: phone,
          notes: noteBits.join('\n'), lead_type: 'Buyer',
          community: 'IDX Listing', page: location.pathname })
      }).then(function () {
        var done = document.createElement('p');
        done.style.cssText = 'padding:1rem;background:#f4efe2;border-radius:8px;color:#0a2540;font-weight:600;';
        done.textContent = 'Thank you. Your message went straight to The Adamson Group; expect a personal reply shortly.';
        f.replaceWith(done);
      }).catch(function () {
        var err = document.createElement('p');
        err.style.cssText = 'padding:.6rem 0;color:#b00020;font-size:.85rem;';
        err.textContent = 'Something went wrong. Please call (941) 713-9234.';
        f.appendChild(err);
      });
    }, true);

    run(); setTimeout(run, 1200); setTimeout(run, 3000);
  })();
</script>
