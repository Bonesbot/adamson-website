<script is:inline>
  (function () {
    /* Lightbox */
    var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-lightbox-src]'));
    var box = document.getElementById('mm-lightbox');
    var imgEl = document.getElementById('mm-lb-img');
    var capEl = document.getElementById('mm-lb-cap');
    var idx = 0;
    function show(i) {
      idx = (i + triggers.length) % triggers.length;
      var t = triggers[idx];
      imgEl.src = t.getAttribute('data-lightbox-src');
      imgEl.alt = t.getAttribute('data-lightbox-caption') || '';
      capEl.textContent = t.getAttribute('data-lightbox-caption') || '';
      box.classList.remove('hidden'); box.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function hide() {
      box.classList.add('hidden'); box.classList.remove('flex');
      imgEl.src = ''; document.body.style.overflow = '';
    }
    triggers.forEach(function (t, i) { t.addEventListener('click', function () { show(i); }); });
    document.getElementById('mm-lb-close').addEventListener('click', hide);
    document.getElementById('mm-lb-prev').addEventListener('click', function () { show(idx - 1); });
    document.getElementById('mm-lb-next').addEventListener('click', function () { show(idx + 1); });
    box.addEventListener('click', function (e) { if (e.target === box) hide(); });
    document.addEventListener('keydown', function (e) {
      if (box.classList.contains('hidden')) return;
      if (e.key === 'Escape') hide();
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });

    /* Plan-specific inquiries pre-fill the request form */
    var form = document.querySelector('form[name="mira-mar-request"]');
    if (!form) return;
    var planField = form.querySelector('input[name="plan"]');
    var msg = form.querySelector('textarea[name="message"]');
    Array.prototype.forEach.call(document.querySelectorAll('.plan-inquire'), function (a) {
      a.addEventListener('click', function () {
        var p = a.getAttribute('data-plan') || '';
        planField.value = p;
        if (msg && !msg.value) msg.value = 'Please send pricing and the floor plan for ' + p + '.';
        var cb = form.querySelector('input[name="wants"][value="Pricing by floor and view"]');
        if (cb) cb.checked = true;
      });
    });

    /* Submit through community-lead (spam check, Supabase, CRM, team email) */
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var btn = form.querySelector('button[type=submit]');
      if (btn) btn.disabled = true;
      var wants = fd.getAll('wants').join(', ') || '-';
      var notes = ['Mira Mar request', 'Wants: ' + wants];
      if (fd.get('plan')) notes.push('Plan: ' + fd.get('plan'));
      if (fd.get('message')) notes.push('Message: ' + fd.get('message'));
      fetch('/.netlify/functions/community-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'), email: fd.get('email'), phone: fd.get('phone') || '',
          notes: notes.join('\n'), lead_type: 'Buyer', community: 'Mira Mar Residences',
          page: location.pathname, source: 'mira-mar-sarasota:request', 'bot-field': fd.get('bot-field') || ''
        })
      }).then(function (r) {
        if (!r.ok) throw new Error('status ' + r.status);
        window.location.href = '/thank-you/';
      }).catch(function () { form.submit(); });
    });
  })();
</script>
