import projectsData from '@/data/newconstruction/projects.json';

const project: any = projectsData.projects.find((p: any) => p.slug === 'mira-mar-sarasota');
const IMG = '/images/new-construction/mira-mar';
const img = (name: string, sm = false) => `${IMG}/${name}${sm ? '-sm' : ''}.jpg`;
