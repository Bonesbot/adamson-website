/* History: developer brochure timeline (abridged) */
const timeline = [
  { year: '1922', text: 'Chicago industrialist Andrew McAnsh breaks ground on the Mira Mar Hotel, Apartments and Auditorium, the largest building project in Sarasota\'s history at the time.' },
  { year: '1923', text: 'The Mira Mar Auditorium opens and the Mira Mar hosts a Metropolitan Opera concert. The hotel becomes downtown\'s social and cultural hub through the land boom.' },
