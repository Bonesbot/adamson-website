---
/**
 * /new-construction — HUB PAGE (LIVE)
 * Composes hero, trust strip, interactive map, comparison table, area
 * pillars, IDX slot, live market KPIs, Why Ryan, FAQ, booking + VIP.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/newconstruction/Hero.astro';
import TrustBar from '@/components/newconstruction/TrustBar.astro';
import ProjectMap from '@/components/newconstruction/ProjectMap.astro';
import ProjectComparisonTable from '@/components/newconstruction/ProjectComparisonTable.astro';
import AreaSection from '@/components/newconstruction/AreaSection.astro';
import IdxAreaShowcase from '@/components/IdxAreaShowcase.astro';
import MarketDataKpis from '@/components/newconstruction/MarketDataKpis.astro';
import WhyRyanBlock from '@/components/newconstruction/WhyRyanBlock.astro';
import FAQSchema from '@/components/seo/FAQSchema.astro';
import SchedulerEmbed from '@/components/newconstruction/SchedulerEmbed.astro';
import VipForm from '@/components/newconstruction/VipForm.astro';
import StickyMobileCta from '@/components/newconstruction/StickyMobileCta.astro';
import DisclosureFooter from '@/components/newconstruction/DisclosureFooter.astro';
import projectsData from '@/data/newconstruction/projects.json';
import faqData from '@/data/newconstruction/faq.json';
import dtStats from '@/data/downtown-sarasota-stats.json';

const projects = projectsData.projects;
const downtownProjects = projects.filter((p) => p.area === 'downtown-sarasota');
const islandProjects = projects.filter((p) => p.area === 'barrier-islands');

const pins = projects.map((p) => ({
  slug: p.slug,
  name: p.name,
  area: p.area,
  island: p.island,
  status: p.status,
  price_range: p.price_range,
  lat: p.lat,
  lng: p.lng,
}));

// Live pipeline stats (regenerated daily from Stellar MLS via Supabase)
const statsAsOf = dtStats?.lastUpdated ? new Date(dtStats.lastUpdated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : undefined;
const kpis = [
  { label: 'Active New-Construction Listings (2020+)', value: String(dtStats?.active?.newConstructionCount ?? '—') },
  { label: 'Median $/SqFt — Active Downtown', value: dtStats?.active?.medianPricePerSqFt ?? '—' },
  { label: 'Median Days on Market — Sold', value: String(dtStats?.sold?.medianDom ?? '—') },
];

const description =
  "Sarasota new construction: 8 active luxury condo projects downtown, on Golden Gate Point and the barrier islands, with pricing and completion dates.";

const jsonLd: Record<string, any>[] = [
  {
    '@type': 'CollectionPage',
    name: "Sarasota's Luxury New Construction",
    description,
    url: 'https://adamsonfl.com/new-construction',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Place',
          name: p.name,
          url: `https://adamsonfl.com/new-construction/${p.slug}`,
        },
      })),
    },
  },
  { '@type': 'Place', name: 'Downtown Sarasota', address: { '@type': 'PostalAddress', addressLocality: 'Sarasota', addressRegion: 'FL', addressCountry: 'US' } },
  { '@type': 'Place', name: 'Lido Key', address: { '@type': 'PostalAddress', addressLocality: 'Sarasota', addressRegion: 'FL', addressCountry: 'US' } },
  { '@type': 'Place', name: 'Longboat Key', address: { '@type': 'PostalAddress', addressLocality: 'Longboat Key', addressRegion: 'FL', addressCountry: 'US' } },
  { '@type': 'Place', name: 'Siesta Key', address: { '@type': 'PostalAddress', addressLocality: 'Sarasota', addressRegion: 'FL', addressCountry: 'US' } },
  {
    '@type': 'RealEstateAgent',
    name: 'Ryan Adamson',
    url: 'https://adamsonfl.com',
    jobTitle: 'Luxury Real Estate Agent',
    worksFor: { '@type': 'RealEstateOrganization', name: 'Coldwell Banker Realty — St. Armands' },
    hasCredential: [
      { '@type': 'EducationalOccupationalCredential', name: 'Certified Luxury Home Marketing Specialist (CLHMS)' },
      { '@type': 'EducationalOccupationalCredential', name: 'Million Dollar Guild' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqData.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://adamsonfl.com/' },
      { '@type': 'ListItem', position: 2, name: 'New Construction', item: 'https://adamsonfl.com/new-construction' },
    ],
  },
];
---

<BaseLayout
  title="Luxury New Construction in Sarasota"
  description={description}
  canonicalUrl="https://adamsonfl.com/new-construction"
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <Hero
    eyebrow="New Construction Hub"
    headline="Sarasota's Luxury New Construction — From Pre-Construction to Move-In Ready"
    subhead="Eight active luxury projects, one honest scorecard — current pricing, completion timelines, and the release calendars the sales galleries don't publish, tracked by Ryan Adamson."
    primaryCtaLabel="Book a Private Tour"
    primaryCtaHref="#schedule"
    secondaryCtaLabel="Join the VIP List"
    secondaryCtaHref="#vip"
    image="/images/new-construction/hub-hero.jpg"
    imageCredit="Courtesy of Kolter Urban"
    tall={true}
  />

  <!-- 1b. Trust strip -->
  <TrustBar />

  <!-- 2. Interactive map -->
  <ProjectMap pins={pins} />

  <!-- 3. At-a-glance comparison table -->
  <ProjectComparisonTable projects={projects} />

  <!-- 4a. Downtown Sarasota area block -->
  <AreaSection
    eyebrow="Downtown Sarasota"
    heading="Downtown Sarasota"
    intro="Downtown Sarasota is in the largest luxury building cycle in its history. As of July 2026, seven projects are active in the core — from The Gallery's under-$1M Rosemary District residences to the Ritz-Carlton's $3.7M+ bayfront tower at The Quay, with Golden Gate Point's boutique buildings (The Owen, SIX88, Amara) in between. Five buildings deliver in 2026; Amara and Mira Mar carry the pipeline to 2028. Buyers choose downtown for walkability, amenity depth, and the widest price range in the market."
    projects={downtownProjects.slice(0, 3)}
    viewAllHref="/new-construction/downtown-sarasota"
    variant="dark"
  />

  <!-- 4b. Barrier Islands area block -->
  <AreaSection
    eyebrow="Barrier Islands"
    heading="Barrier Islands"
    intro="On the islands, new construction is scarce by design — and that scarcity is the story. Rosewood Residences Lido Key, the brand's first stand-alone residential project anywhere in the world, is welcoming owners through 2026 and carries the entire beachfront new-construction market. Longboat Key stays low-rise with new supply arriving as individual Gulf-front estates, and Siesta Key remains a custom-build market. When island product is this limited, knowing the resale and off-market landscape matters as much as the developer brochures."
    projects={islandProjects.length > 0 ? islandProjects : downtownProjects.slice(3, 6)}
    viewAllHref="/new-construction/barrier-islands"
    variant="elevated"
  />

  <!-- 5. Active listings: IDX Broker showcase widget 50188 (all 8 tracked projects, ZIP 34236) -->
  <IdxAreaShowcase
    widgetId="50188"
    scriptSrc="https://adamsonfl.idxbroker.com/idx/customshowcasejs.php?widgetid=50188"
    areaName="Sarasota New Construction"
    label="Currently available"
    heading="Currently Listed Across Sarasota's New Towers"
    intro="Live Stellar MLS listings from the eight projects tracked on this page: Mira Mar, The Owen, The Ritz-Carlton Residences, Rosewood Lido Key, Amara, The Edge, The Gallery and SIX88."
    viewAllUrl="/idx/results/listings?idxID=d003&pt=1&ccz=zipcode&zipcode[]=34236&a_subdivision[]=Mira+Mar&a_subdivision[]=The+Owen+Golden+Gate+Point&a_subdivision[]=Ritz-carlton+Residences%2C+Sarasota+Bay&a_subdivision[]=Ritz-carlton+Residences%2C+Sarasota&a_subdivision[]=Ritz+Carlton+Residences+Sarasota&a_subdivision[]=Ritz+Carlton+Residences+Quay+Sarasota&a_subdivision[]=Rosewood+Residences+Lido+Key&a_subdivision[]=Amara+On+Sarasota+Bay&a_subdivision[]=The+Edge+Sarasota&a_subdivision[]=The+Gallery+Sarasota&a_subdivision[]=Six88+Sarasota&per=100"
    viewAllLabel="View every new-construction listing"
    offMarketText="Developer releases and pre-construction reservations usually never reach the MLS. Tell Ryan what you are looking for and he will source it across every sales gallery in town."
  />

  <!-- 6. Market data snapshot (live pipeline stats) -->
  <MarketDataKpis scope="Downtown Sarasota Market" kpis={kpis} asOf={statsAsOf} source="Stellar MLS via Adamson Group data pipeline" />

  <!-- 7. Why Ryan -->
  <WhyRyanBlock />

  <!-- 8. FAQ -->
  <FAQSchema
    faqs={faqData.faqs}
    heading="Sarasota New Construction FAQ"
  />

  <!-- 9. Booking + VIP form -->
  <SchedulerEmbed />
  <VipForm />

  <!-- Sticky mobile CTA -->
  <StickyMobileCta />

  <!-- Disclosures -->
  <DisclosureFooter showListingAttribution={true} showFactAttribution={true} lastVerified="2026-07-01" />
</BaseLayout>
