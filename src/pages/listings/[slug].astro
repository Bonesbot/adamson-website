    <script is:inline define:vars={{ fm: l.fun_map, homeLL: [l.lat, l.lng], addr: l.address }}>
    (function(){
      if(!window.L) return;
      var el=document.getElementById('funMap'); if(!el) return;
      var mobile=L.Browser.mobile;
      var map=L.map(el,{scrollWheelZoom:false, dragging:!mobile, tap:false, zoomControl:false, attributionControl:true});
      L.control.zoom({position:'topright'}).addTo(map);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19, attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
      function icon(emoji,bg,big){
        var sz=big?54:40;
        return L.divIcon({className:'fm-pin', iconSize:[sz,sz], iconAnchor:[sz/2,sz/2], popupAnchor:[0,-sz/2],
          html:'<span style="background:'+bg+';width:'+sz+'px;height:'+sz+'px;font-size:'+(big?26:19)+'px">'+emoji+'</span>'});
      }
      function dirLink(ll){ return 'https://www.google.com/maps/dir/?api=1&origin='+homeLL[0]+','+homeLL[1]+'&destination='+ll[0]+','+ll[1]; }
      function card(o,isHome){
        return '<div class="fm-card">'+(o.photo?'<img src="'+o.photo+'" alt="">':'')+
          '<div class="fm-card-b"><strong>'+o.title+'</strong>'+(o.note?'<span>'+o.note+'</span>':'')+
          (o.dist?'<em>'+o.dist+'</em>':'')+
          (isHome?'':'<a href="'+dirLink([o.lat,o.lng])+'" target="_blank" rel="noopener">Directions from the house →</a>')+'</div></div>';
      }
      var markers={}, bounds=[homeLL];
      if(fm.route && fm.route.coords){
        L.polyline(fm.route.coords,{color:'#ffffff',weight:9,opacity:.85,lineCap:'round'}).addTo(map);
        L.polyline(fm.route.coords,{color:fm.route.color||'#2F9E8F',weight:4,dashArray:'1 9',lineCap:'round'}).addTo(map)
          .bindTooltip(fm.route.label||'Bike route',{sticky:true});
      }
      fm.pins.forEach(function(p){
        var m=L.marker([p.lat,p.lng],{icon:icon(p.icon,p.color,false),title:p.title}).addTo(map).bindPopup(card(p,false),{maxWidth:240,minWidth:220});
        markers[p.id]=m; if(p.fit!==false) bounds.push([p.lat,p.lng]);
      });
      var h=fm.home||{};
      markers.home=L.marker(homeLL,{icon:icon('🏡','#C5A55A',true),title:addr,zIndexOffset:1000}).addTo(map)
        .bindPopup(card({title:h.title||addr,note:h.note,photo:h.photo},true),{maxWidth:240,minWidth:220});
      map.fitBounds(bounds,{padding:[36,36]});
      document.querySelectorAll('#funLegend [data-pin]').forEach(function(b){
        b.addEventListener('click',function(){
          var m=markers[b.getAttribute('data-pin')]; if(!m) return;
          if(window.innerWidth<1024) el.scrollIntoView({behavior:'smooth',block:'center'});
          var id=b.getAttribute('data-pin'), pz=(fm.pins.filter(function(x){return x.id===id;})[0]||{}).zoom;
          map.flyTo(m.getLatLng(), Math.max(map.getZoom(), pz || (id==='home'?16:14)), {duration:.6});
          setTimeout(function(){ m.openPopup(); },650);
        });
      });
      if(mobile){ el.addEventListener('click',function(){ map.dragging.enable(); },{once:true}); }
    })();
    </script>
  </section>
