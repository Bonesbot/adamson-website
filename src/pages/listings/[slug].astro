---
/**
 * /listings/[slug] — Feature-property landing page (941props.com format, AdamsonFL design)
 *
 * Data-driven: one JSON file per listing in src/data/listings/*.json.
 * Add/edit a listing = edit its JSON (see LISTINGS_PLAYBOOK.md + scripts/listings/new_listing.py).
 * Section flow mirrors the proven 941props layout:
 *   hero → stat bar → key features → price/CTA → virtual & video tour → floor plan
 *   → map → photo tour (lightbox) → inquiry form (lead capture → srqmap-lead fn → Supabase + IDX)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/listings/*.json', { eager: true });
  return Object.values(files).map((mod: any) => {
    const l = mod.default ?? mod;
    return { params: { slug: l.slug }, props: { l } };
  });
}

const { l } = Astro.props as { l: any };

const fmtPrice = (n: number) => '$' + n.toLocaleString('en-US');
const STATUS: Record<string, { badge: string; prefix: string; avail: string }> = {
  'active':      { badge: 'For Sale',            prefix: 'Offered at',            avail: 'https://schema.org/InStock' },
  'coming-soon': { badge: 'Coming Soon',         prefix: 'Anticipated at',        avail: 'https://schema.org/PreOrder' },
  'off-market':  { badge: 'Private · Off-Market', prefix: 'Offered privately at', avail: 'https://schema.org/InStock' },
  'pending':     { badge: 'Pending',             prefix: 'Offered at',            avail: 'https://schema.org/SoldOut' },
  'sold':        { badge: 'Sold',                prefix: 'Last offered at',       avail: 'https://schema.org/SoldOut' },
};
const st = STATUS[l.status] || STATUS['active'];
// Optional per-listing overrides (e.g. rentals: price_label "Offered at $5,500 / month", badge "For Rent")
const badge = l.badge || st.badge;
const priceLabel = l.price_label || `${st.prefix} ${fmtPrice(l.price)}`;
const fullAddress = `${l.address}, ${l.city}, ${l.state} ${l.zip}`;
const pageTitle = `${l.address} — ${l.neighborhood}, ${l.city} FL`;
const canonical = `https://adamsonfl.com/listings/${l.slug}/`;
// Meta description: the facts an answer engine would quote, under ~155 chars. The long
// listing copy stays in the body and JSON-LD.
const metaDescription = `${l.address}, ${l.city} FL: ${l.beds} bed, ${l.baths} bath, ${Number(l.sqft).toLocaleString('en-US')} sq ft${l.year_built ? `, built ${l.year_built}` : ''}. ${l.price_label_short || priceLabel}. Listed by Ryan Adamson, Coldwell Banker.`;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(l.map_query || fullAddress)}&t=m&z=13&output=embed&iwloc=near`;

// ── Optional, opt-in blocks (2026-11, first used by 5654-woodland-sage-dr). Listings that
// don't set these render exactly as before. See LISTINGS_PLAYBOOK.md "Optional blocks".
const cta = l.cta || {};
const coAgent = l.co_agent || null;
const agentNames = coAgent ? `Ryan or ${coAgent.name.split(' ')[0]}` : 'Ryan';
// photo_groups [{title, photos[]}] wins over the flat photos[] list; the flat list is still
// what schema/og use, so we derive it when only groups are given.
const photoGroups: { title: string; photos: string[] }[] =
  (l.photo_groups && l.photo_groups.length) ? l.photo_groups : [{ title: '', photos: l.photos || [] }];
const allPhotos: string[] = photoGroups.flatMap((g) => g.photos);
const floorPlans: string[] = (l.floor_plans && l.floor_plans.length) ? l.floor_plans : (l.floor_plan ? [l.floor_plan] : []);
// Time-boxed content: any block with `expires` (ISO date-time) is dropped at build time once
// past, and hidden in the browser the moment it passes (data-expires), so a page that is
// not rebuilt still rolls it off on schedule.
const nowMs = Date.now();
const live = (x: any) => !x || !x.expires || Date.parse(x.expires) > nowMs;
const callout = l.callout && live(l.callout) ? l.callout : null;
const interests = (cta.interests || [])
  .map((t: any) => (typeof t === 'string' ? { label: t } : t))
  .filter(live);
const faqs = (l.faq || []).filter(live);
const lifeCols = (l.lifestyle?.items || []).length >= 8 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
const isolated = !!l.standalone;
const leadEndpoint = l.lead_endpoint === 'community' ? '/.netlify/functions/community-lead' : '/.netlify/functions/srqmap-lead';
// Hero crop: hero_focus / hero_focus_mobile are CSS object-position values (e.g. "50% 100%" = bottom).
const heroFocus = `--fp:${l.hero_focus || '50% 50%'};--fpm:${l.hero_focus_mobile || l.hero_focus || '50% 50%'}`;
const statCols = (l.stats || []).length > 4 ? 'md:grid-cols-3 lg:grid-cols-6' : 'md:grid-cols-4';
const ICONS: Record<string, string> = {
  splash: 'M12 3c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z',
  pool:   'M2 17c2 0 2-1.5 4-1.5S8 17 10 17s2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5M2 21c2 0 2-1.5 4-1.5S8 21 10 21s2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5M8 13V5a2 2 0 0 1 4 0M16 13V5a2 2 0 0 0-4 0M8 9h8',
  play:   'M4 21V8l4-4 4 4v13M12 12l8 8M4 13h8M18 4v4',
  ball:   'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c-3 3-3 15 0 18M12 3c3 3 3 15 0 18',
  paw:    'M8 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM16 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM5 15a1.7 1.7 0 1 0 0-3.4A1.7 1.7 0 0 0 5 15zM19 15a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4zM12 13c-3 0-5 3-5 5 0 1.5 1.5 2 2.5 2 1 0 1.5-.5 2.5-.5s1.5.5 2.5.5c1 0 2.5-.5 2.5-2 0-2-2-5-5-5z',
  fit:    'M2 12h2M20 12h2M6 8v8M18 8v8M4 10v4M20 10v4M6 12h12',
  sun:    'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4',
  school: 'M2 9l10-5 10 5-10 5-10-5zM6 11v5c3 2 9 2 12 0v-5M22 9v6',
  home:   'M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6',
};

const residence = {
  '@type': 'SingleFamilyResidence',
  name: l.address,
  address: { '@type': 'PostalAddress', streetAddress: l.address, addressLocality: l.city, addressRegion: l.state, postalCode: l.zip, addressCountry: 'US' },
  ...(l.lat && l.lng ? { geo: { '@type': 'GeoCoordinates', latitude: l.lat, longitude: l.lng } } : {}),
  ...(l.sqft ? { floorSize: { '@type': 'QuantitativeValue', value: l.sqft, unitCode: 'FTK' } } : {}),
  ...(l.beds ? { numberOfBedrooms: l.beds } : {}),
  ...(l.baths ? { numberOfBathroomsTotal: l.baths } : {}),
  ...(l.year_built ? { yearBuilt: l.year_built } : {}),
};
const jsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateListing',
    url: canonical,
    name: pageTitle,
    description: l.description,
    image: allPhotos.slice(0, 8),
    about: residence,
    offers: {
      '@type': 'Offer',
      price: l.price,
      priceCurrency: 'USD',
      availability: st.avail,
      offeredBy: coAgent
        ? [
            { '@type': 'RealEstateAgent', name: 'Ryan Adamson, PA', telephone: '+1-941-713-9234', email: 'Ryan@Adamson-Group.com', ...(isolated ? {} : { url: 'https://adamsonfl.com/about' }) },
            { '@type': 'RealEstateAgent', name: coAgent.name, ...(coAgent.phone ? { telephone: coAgent.phone } : {}), ...(coAgent.email ? { email: coAgent.email } : {}) },
          ]
        : { '@type': 'RealEstateAgent', name: 'Ryan Adamson, PA', telephone: '+1-941-713-9234', email: 'Ryan@Adamson-Group.com', url: 'https://adamsonfl.com/about' },
    },
  },
];
if (!isolated) jsonLd.push(
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://adamsonfl.com/' },
      { '@type': 'ListItem', position: 2, name: 'Featured Listings', item: 'https://adamsonfl.com/listings' },
      { '@type': 'ListItem', position: 3, name: l.address, item: canonical },
    ],
  }
);
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  ogImage={l.hero_image}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
  noIndex={!!l.noindex}
  isolated={isolated}
>

<style is:global>
  /* Fun-map markers & popups are created by Leaflet at runtime, so they need global (unscoped) rules. */
  #funMap .fm-pin span{display:grid;place-items:center;border-radius:999px;border:3px solid #fff;box-shadow:0 6px 16px rgba(0,0,0,.35);line-height:1}
  #funMap .fm-card img{width:100%;height:110px;object-fit:cover;border-radius:8px 8px 0 0;display:block}
  #funMap .fm-card-b{padding:10px 4px 4px;display:flex;flex-direction:column;gap:3px;font-family:Inter,system-ui,sans-serif}
  #funMap .fm-card-b strong{font-size:14px;color:#141414}
  #funMap .fm-card-b span{font-size:12px;color:#555;line-height:1.35}
  #funMap .fm-card-b em{font-style:normal;font-size:12px;color:#9C7C34;font-weight:600}
  #funMap .fm-card-b a{font-size:12px;color:#141414;font-weight:600;margin-top:4px;text-decoration:underline}
  #funMap .leaflet-popup-content{margin:8px}
  #funMap .leaflet-popup-content-wrapper{border-radius:12px}
</style>

<style>
  .lst-eyebrow{font-family:var(--font-accent);font-size:11px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--color-gold)}
  .lst-stat-num{font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:700;color:var(--color-gold);line-height:1}
  .lightbox{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.94);align-items:center;justify-content:center}
  .lightbox.open{display:flex}
  .lightbox img{max-width:92vw;max-height:88vh;object-fit:contain;box-shadow:0 30px 90px rgba(0,0,0,.8)}
  .lb-btn{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;border:1px solid rgba(255,255,255,.25);background:rgba(0,0,0,.5);color:#fff;font-size:26px;cursor:pointer;display:grid;place-items:center;padding:0 0 4px;transition:background .15s}
  .lb-btn:hover{background:rgba(197,165,90,.35)}
  .lb-prev{left:18px}.lb-next{right:18px}
  .lb-close{position:absolute;top:16px;right:20px;background:none;border:none;color:rgba(255,255,255,.75);font-size:34px;cursor:pointer;line-height:1}
  .lb-close:hover{color:#fff}
  .lb-count{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font-family:var(--font-accent);font-size:12px;letter-spacing:.12em;color:rgba(255,255,255,.65)}
  .fm-map{height:520px;background:#e8e4da}
  @media (max-width:1023px){.fm-map{height:420px}}
  .fm-item{width:100%;display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:12px;background:#141414;border:1px solid rgba(255,255,255,.07);transition:border-color .15s,transform .15s;cursor:pointer}
  .fm-item:hover{border-color:rgba(197,165,90,.55);transform:translateX(2px)}
  .fm-home{background:linear-gradient(135deg,#1d1a12,#141414);border-color:rgba(197,165,90,.35)}
  .fm-dot{flex:none;width:36px;height:36px;border-radius:999px;display:grid;place-items:center;font-size:17px;border:2px solid #fff}
  .fm-t{display:block;color:#fff;font-size:14px;font-weight:600;line-height:1.25}
  .fm-n{display:block;color:rgba(255,255,255,.55);font-size:12px;line-height:1.35;margin-top:2px}
  .fm-d{flex:none;color:var(--color-gold-light);font-size:12px;text-align:right;max-width:90px;line-height:1.3}
  .lst-hero-media{object-position:var(--fpm,50% 50%)}
  @media (min-width:768px){.lst-hero-media{object-position:var(--fp,50% 50%)}}
  .lst-callout{background:linear-gradient(180deg,#000 0,#000 50%,#0A0A0A 50%,#0A0A0A 100%)}
  .lst-callout-card{background:linear-gradient(135deg,#FBF7EE 0%,#F3EAD6 100%);box-shadow:0 20px 60px rgba(0,0,0,.45)}
  .lst-callout-card .lst-eyebrow,.lst-life .lst-eyebrow{color:#9C7C34}
  .lst-life{background:#F7F2E7}
  .lst-chip span{display:inline-block;font-size:13px;padding:8px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.78);cursor:pointer;transition:all .15s;user-select:none}
  .lst-chip span:hover{border-color:rgba(197,165,90,.6)}
  .lst-chip input:checked + span{background:var(--color-gold);border-color:var(--color-gold);color:#000;font-weight:600}
  .lst-chip input:focus-visible + span{outline:2px solid var(--color-gold-light);outline-offset:2px}
  .gallery-grid img{cursor:pointer;transition:opacity .2s ease,transform .25s ease}
  .gallery-grid img:hover{opacity:.85;transform:scale(1.015)}
</style>

  <!-- ══════════ HERO ══════════ -->
  <section class="relative min-h-[86vh] flex items-end overflow-hidden">
    {l.hero_video
      ? <video class="lst-hero-media absolute inset-0 w-full h-full object-cover" style={heroFocus} src={l.hero_video} poster={l.hero_image} autoplay muted loop playsinline preload="metadata" aria-label={`Video of ${l.address}`}></video>
      : <picture>
          {l.hero_image_mobile && <source media="(max-width: 767px)" srcset={l.hero_image_mobile} />}
          <img src={l.hero_image} alt={`${l.address} — ${l.neighborhood}`} class="lst-hero-media absolute inset-0 w-full h-full object-cover" style={heroFocus} fetchpriority="high" />
        </picture>}
    <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(0,0,0,.42) 0%, rgba(0,0,0,.12) 40%, rgba(0,0,0,.82) 100%)"></div>
    <div class="container relative z-10 pb-16 pt-40">
      <span class="inline-block font-accent text-[10px] uppercase tracking-[0.2em] font-bold px-3.5 py-1.5 rounded-full mb-5 bg-[var(--color-gold)] text-black">{badge}</span>
      <p class="lst-eyebrow mb-3" style="text-shadow:0 1px 10px rgba(0,0,0,.65)">{l.tagline}</p>
      <h1 class="font-display text-white font-bold leading-[1.05]" style="font-size:clamp(2.4rem,6vw,4.5rem)">{l.address}</h1>
      <p class="text-white/80 text-lg mt-3">{l.neighborhood} · {l.city}, {l.state} {l.zip}</p>
      <p class="font-display text-[var(--color-gold-light)] text-2xl md:text-3xl font-semibold mt-5">{priceLabel}</p>
      {l.open_house && <p class="font-accent uppercase tracking-[0.15em] text-sm text-white mt-3 font-semibold">{l.open_house}</p>}
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="#inquire" data-pick={cta.hero_pick || ''} class="font-accent text-xs uppercase tracking-[0.15em] font-semibold px-7 py-3.5 rounded-full bg-[var(--color-gold)] text-black hover:bg-[var(--color-gold-light)] transition-colors">{cta.hero_primary || 'Request a Private Showing'}</a>
        <a href="tel:19417139234" class="font-accent text-xs uppercase tracking-[0.15em] font-semibold px-7 py-3.5 rounded-full border border-white/40 text-white hover:border-[var(--color-gold)] hover:text-[var(--color-gold)] transition-colors">Call (941) 713-9234</a>
      </div>
    </div>
  </section>

  <!-- OPEN HOUSE BANNER (smart, self-expiring) -->
  <section id="ohBanner" class="bg-[var(--color-gold)] text-black" hidden data-slug={l.slug} data-oh={JSON.stringify(l.open_houses || [])}>
    <div class="container py-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-center">
      <span class="font-accent text-[11px] uppercase tracking-[0.22em] font-bold">Open House</span>
      <span id="ohWhen" class="font-semibold text-sm"></span>
      <a href="#rsvp" class="font-accent text-[11px] uppercase tracking-[0.15em] font-bold px-5 py-2 rounded-full bg-black text-[var(--color-gold)] hover:bg-[#111] transition-colors">RSVP</a>
    </div>
  </section>

  <!-- ══════════ STAT BAR ══════════ -->
  <section class="bg-black border-y border-white/[0.06]">
    <div class="container py-12">
      <div class={`grid grid-cols-2 ${statCols} gap-10 text-center`}>
        {l.stats.map((s: any) => (
          <div>
            <div class="lst-stat-num">{s.value}</div>
            <div class="font-accent text-[11px] uppercase tracking-[0.2em] text-white/60 mt-2">{s.label}</div>
          </div>
        ))}
      </div>
      {l.quick_facts && l.quick_facts.length > 0 && (
        <ul class="mt-10 pt-8 border-t border-white/[0.06] flex flex-wrap justify-center gap-x-2 gap-y-3">
          {l.quick_facts.map((q: string) => (
            <li class="font-accent text-[11px] uppercase tracking-[0.16em] text-white/75 px-4 py-2 rounded-full border border-white/[0.12]">{q}</li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {callout && (
  <!-- ══════════ CALLOUT (opt-in; e.g. homestead / year-end timing) ══════════ -->
  <section class="lst-callout py-14" data-expires={callout.expires || undefined}>
    <div class="container">
      <div class="lst-callout-card grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-center rounded-2xl p-8 md:p-12">
        <div>
          {callout.eyebrow && <p class="lst-eyebrow mb-3">{callout.eyebrow}</p>}
          <h2 class="font-display text-[#141414] text-3xl md:text-4xl font-bold leading-tight">{callout.title}</h2>
          {callout.text && <p class="text-[#3a3630] mt-4 leading-relaxed">{callout.text}</p>}
          {callout.button && (
            <a href={callout.href || '#inquire'} data-pick={callout.pick || ''} class="inline-block mt-7 font-accent text-xs uppercase tracking-[0.15em] font-semibold px-7 py-3.5 rounded-full bg-[#141414] text-[var(--color-gold-light)] hover:bg-black transition-colors">{callout.button}</a>
          )}
        </div>
        <div>
          {callout.bullets && (
            <ul class="space-y-4">
              {callout.bullets.map((b: string) => (
                <li class="flex gap-3 text-[#2b2823] text-[15px] leading-relaxed">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-gold)]"></span><span>{b}</span>
                </li>
              ))}
            </ul>
          )}
          {callout.footnote && <p class="text-[#6b655b] text-xs mt-6 leading-relaxed">{callout.footnote}</p>}
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ══════════ KEY FEATURES ══════════ -->
  <section class="bg-[#0A0A0A] py-20">
    <div class="container">
      <p class="lst-eyebrow text-center mb-3">The Details</p>
      <h2 class="font-display text-white text-3xl md:text-4xl font-bold text-center mb-14">Key Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {l.features.map((f: any) => (
          <div class="bg-[#111111] border border-white/[0.06] rounded-lg overflow-hidden hover:border-[var(--color-gold)]/40 transition-colors">
            {f.photo && <img src={f.photo} alt={f.title} loading="lazy" decoding="async" class="w-full aspect-[16/10] object-cover" style={f.photo_focus ? `object-position:${f.photo_focus}` : undefined} />}
            <div class="p-8">
              <h3 class="font-display text-[var(--color-gold)] text-xl font-semibold mb-3">{f.title}</h3>
              <p class="text-white/70 text-sm leading-relaxed">{f.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {l.lifestyle && (
  <!-- ══════════ LIFESTYLE (opt-in; warm light section) ══════════ -->
  <section class="lst-life py-20">
    <div class="container">
      {l.lifestyle.eyebrow && <p class="lst-eyebrow text-center mb-3">{l.lifestyle.eyebrow}</p>}
      <h2 class="font-display text-[#141414] text-3xl md:text-4xl font-bold text-center">{l.lifestyle.title}</h2>
      {l.lifestyle.intro && <p class="text-[#4a453d] text-center max-w-2xl mx-auto mt-4 leading-relaxed">{l.lifestyle.intro}</p>}
      {l.lifestyle.items && (
        <div class={`grid grid-cols-2 ${lifeCols} gap-4 md:gap-6 mt-12`}>
          {l.lifestyle.items.map((it: any) => (
            <div class="bg-white rounded-xl overflow-hidden border border-[#e8e0cf] hover:border-[var(--color-gold)] hover:-translate-y-0.5 transition-all">
              {it.photo && <img src={it.photo} alt={it.title} loading="lazy" decoding="async" class="w-full aspect-[16/10] object-cover" />}
              <div class={it.photo ? 'p-4 md:p-5' : 'p-5 md:p-7'}>
              {!it.photo && it.icon && ICONS[it.icon] && (
                <svg viewBox="0 0 24 24" class="h-8 w-8 mb-4" fill="none" stroke="#B08F45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS[it.icon]} /></svg>
              )}
              <h3 class="font-display text-[#141414] text-lg md:text-xl font-semibold">{it.title}</h3>
              {it.text && <p class="text-[#5a554c] text-sm leading-relaxed mt-2">{it.text}</p>}
              </div>
            </div>
          ))}
        </div>
      )}
      {(l.lifestyle.nearby || l.lifestyle.schools) && (
        <div class={(l.lifestyle.nearby && l.lifestyle.schools) ? 'grid md:grid-cols-2 gap-6 mt-8' : 'max-w-2xl mx-auto mt-8'}>
          {l.lifestyle.nearby && (
