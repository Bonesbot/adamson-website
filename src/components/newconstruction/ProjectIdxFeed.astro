---
/**
 * ProjectIdxFeed : live Stellar MLS availability for one new-construction project.
 *
 * Reads project.idx (widget_id, results_path, saved_link) from projects.json and
 * renders the IDX Broker legacy Showcase widget through IdxAreaShowcase (which
 * carries the shadow-DOM link rewrite that keeps click-throughs on adamsonfl.com).
 * Falls back to the IdxListingGrid placeholder panel when a project has no feed yet.
 *
 * Saved links and widgets live in the IDX control panel (see projects.json _meta.idx_notes).
 */
import IdxAreaShowcase from '@/components/IdxAreaShowcase.astro';
import IdxListingGrid from './IdxListingGrid.astro';

interface Props {
  project: any;
  /** Section eyebrow label. */
  label?: string;
  /** Optional id for in-page anchors. */
  id?: string;
}

const { project, label = 'Live availability', id = 'availability' } = Astro.props;
const idx = project.idx || {};
const hasFeed = Boolean(idx.widget_id);
const addr = project.mls_street_address ? ` at ${project.mls_street_address}` : '';
---

{hasFeed ? (
  <div id={id} class="scroll-mt-20">
    <IdxAreaShowcase
      widgetId={String(idx.widget_id)}
      scriptSrc={`https://adamsonfl.idxbroker.com/idx/customshowcasejs.php?widgetid=${idx.widget_id}`}
      areaName={project.name}
      heading={`Currently Listed at ${project.name}`}
      intro={`Every active Stellar MLS listing${addr}, live and updated continuously. Developer-held inventory often never reaches the MLS; ask Ryan for the full availability sheet.`}
      viewAllUrl={idx.results_path}
      viewAllLabel={`View all ${project.name} listings`}
      label={label}
      offMarketText={`Developer releases, resales under contract and unlisted inventory at ${project.name} rarely show up here. Tell Ryan what you want and he will source it, including the residences the sales gallery is not advertising.`}
    />
  </div>
) : (
  <section id={id} class="section dark-section scroll-mt-20">
    <div class="container">
      <p class="section-label text-[var(--color-cbgl-blue-light)] mb-3">{label}</p>
      <h2 class="accent-underline mb-3">Currently Available at {project.name}</h2>
      <p class="text-white/60 mb-10 max-w-2xl">Resale and pre-construction availability through the Stellar MLS feed.</p>
      <IdxListingGrid heading="" subdivisions={project.mls_subdivision ? [project.mls_subdivision] : []} limit={6} />
    </div>
  </section>
)}
