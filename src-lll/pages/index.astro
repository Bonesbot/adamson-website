---
/**
 * LongboatLido.com home: the Longboat Key market page, co-branded Anne Schneider
 * and Ryan Adamson. The body is the shared CobrandAreaPage component (also used by
 * siestareport.com); this file owns the layout, title, description and JSON-LD.
 * Every number comes from src/data/longboat-key-stats.json (daily pipeline), the
 * island copy from areas.json + area-media.json. No links back to AdamsonFL.com.
 */
import LLLLayout from '../layouts/LLLLayout.astro';
import CobrandAreaPage from '@/components/market/CobrandAreaPage.astro';
import { buildAreaModel } from '@/lib/cobrandArea';
import areasJson from '@/data/areas.json';
import areaMedia from '@/data/area-media.json';
import stats from '@/data/longboat-key-stats.json';

const area: any = (areasJson as any).areas.find((a: any) => a.slug === 'longboat-key');
const media: any = (areaMedia as any)['longboat-key'] || {};
const names = { agentsShort: 'Anne and Ryan', agentsFull: 'Anne Schneider and Ryan Adamson' };
const { asOfIso, faqs, summary } = buildAreaModel(stats, area, media, names);

const description = `Longboat Key real estate market data from Anne Schneider and Ryan Adamson, Coldwell Banker Realty, St. Armands: ${stats.active.count} active listings, median sold price ${stats.sold.medianPrice} over the last ${stats.sold.windowDays} days, ${stats.marketBalance.monthsOfSupply} months of supply, with Gulf-front, bayfront, condo and single-family segments tracked separately from live Stellar MLS data.`;

const jsonLd = [
  {
    '@type': 'Place',
    name: 'Longboat Key',
    description: summary,
    address: { '@type': 'PostalAddress', addressLocality: 'Longboat Key', addressRegion: 'FL', postalCode: '34228', addressCountry: 'US' },
  },
  {
    '@type': 'WebPage',
    name: 'Longboat Key Real Estate Market Guide',
    description,
    url: 'https://longboatlido.com/',
    ...(asOfIso && { dateModified: asOfIso }),
    author: [
      { '@type': 'RealEstateAgent', name: 'Anne Schneider', worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' } },
      { '@type': 'RealEstateAgent', name: 'Ryan Adamson', worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' } },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
];
---

<LLLLayout title="Home" description={description} jsonLd={jsonLd}>
  <CobrandAreaPage
    uid="lbk"
    area={area}
    media={media}
    stats={stats}
    heroImage="/images/areas/longboat-key.jpg"
    heroPosition="center 40%"
    heroLabel="Longboat Key &middot; 34228 &middot; Gulf to Bay"
    heroTag="Every closed sale and every active listing on the island, from live Stellar MLS records: Gulf-front, bayfront, condo and single-family tracked separately, and two agents who work Longboat Key and Lido Key every day."
    heroTeamLine="Anne Schneider &amp; Ryan Adamson &middot; Coldwell Banker Realty, St. Armands"
    agentsShort={names.agentsShort}
    agentsFull={names.agentsFull}
    teamWorkLine="work Longboat Key and Lido Key together"
    team={[
      { name: 'Anne Schneider', img: '/images/anne-schneider-square.jpg', width: 583, height: 583, alt: 'Anne Schneider, Coldwell Banker Realty', phone: '(310) 562-9710', phoneHref: 'tel:+13105629710', emailEntity: 'Anne&#46;Schneider&#64;cbrealty&#46;com' },
      { name: 'Ryan Adamson', img: '/images/ryan-adamson-square.jpg', width: 800, height: 800, alt: 'Ryan Adamson, Coldwell Banker Global Luxury', phone: '(941) 713-9234', phoneHref: 'tel:+19417139234', emailEntity: 'Ryan&#64;Adamson-Group&#46;com' },
    ]}
    communities={[
      { href: '/country-club-shores/', eyebrow: 'Longboat Key &middot; 34228 &middot; Canal-Front', title: 'Country Club Shores', copy: 'Closed-sale data for the canal-front neighborhood on the south end of Longboat Key: canal-front, open-bayfront and interior homes tracked separately, with price per square foot, days on market and sale-to-list ratios.' },
    ]}
    sellerCopy="Curious what your home or condo would bring today? We'll walk the real closed-sale data above against your building, view, floor and condition. Gulf-front, bayfront, condo and single-family are different markets, and we price them that way. Privately, with no obligation and no listing pressure."
    buyerCopy="The best Gulf-front and bayfront residences on Longboat Key often change hands before they reach the MLS. Tell us what you are looking for and we'll reach out first on available and off-market homes."
    altPhone="(941) 713-9234"
    altPhoneHref="tel:+19417139234"
  />
</LLLLayout>
