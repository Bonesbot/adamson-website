---
/**
 * LongboatLido.com home: the Longboat Key market page, co-branded Anne Schneider
 * and Ryan Adamson. Hand-built (not generated); the island copy comes from
 * src/data/areas.json + area-media.json and every number from the daily pipeline's
 * src/data/longboat-key-stats.json, both shared with the hub repo via the '@' alias,
 * so the numbers here refresh on the same commit as everywhere else.
 *
 * House rules for this site: no links back to AdamsonFL.com anywhere on the page
 * (Anne's ask), medians over averages wherever the pipeline provides one, no em dashes.
 * Layout and classes mirror /country-club-shores so the two pages read as one site.
 */
import LLLLayout from '../layouts/LLLLayout.astro';
import IdxAreaShowcase from '@/components/IdxAreaShowcase.astro';
import areasJson from '@/data/areas.json';
import areaMedia from '@/data/area-media.json';
import stats from '@/data/longboat-key-stats.json';

const area: any = (areasJson as any).areas.find((a: any) => a.slug === 'longboat-key');
const media: any = (areaMedia as any)['longboat-key'] || {};

const asOf = stats.lastUpdated
  ? new Date(stats.lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';
const asOfIso = String(stats.lastUpdated || '').slice(0, 10);

const fmtUsd = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const fmtDate = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Co-brand voice: the pipeline writes its living answers for the hub site.
const cobrand = (s: string) => s
  .replace(/Ryan Adamson's local market guidance/g, "Anne and Ryan's local market guidance")
  .replace(/Ryan Adamson/g, 'Anne Schneider and Ryan Adamson')
  .replace(/\s*—\s*/g, ', ');

const active = stats.active;
const sold = stats.sold;
const mb = stats.marketBalance;
const pts = stats.propertyTypeSplit as any;
const cb90 = (stats as any).costBreakdown90;
const bands = stats.priceBands;
const boating = (stats as any).boating;
const segments = (stats.waterfrontSegments || []) as any[];
const tiers = (stats.condoTiers || []) as any[];
const comps = (stats.recentSoldComps || []) as any[];

const condoDues = stats.fees?.condoFeeRange ?? null;
const duesMedianPct = condoDues && condoDues.max > condoDues.min
  ? Math.round(((condoDues.median - condoDues.min) / (condoDues.max - condoDues.min)) * 100)
  : 0;
const duesPct = Math.min(94, Math.max(6, duesMedianPct));

// Editorial FAQ from areas.json may carry {{tokens}} resolved against the stats file.
function lookupPath(obj: any, path: string): any {
  return path.split('.').reduce((o: any, k: string) => (o == null ? undefined : o[k]), obj);
}
const interpCtx = { ...(stats as any), asOf };
function interpolate(text: string): string | null {
  let ok = true;
  const out = text.replace(/\{\{\s*([\w.]+)\s*\}\}/g, (_m: string, p: string) => {
    const v = lookupPath(interpCtx, p);
    if (v === undefined || v === null || v === '') { ok = false; return ''; }
    return String(v);
  });
  return ok ? out : null;
}
const livingFaqs = ((stats as any).marketQuestions || []).map((q: any) => ({ question: cobrand(q.q), answer: cobrand(q.a) }));
const editorialFaqs = (area.faqs || [])
  .map((f: any) => ({ question: f.question, answer: interpolate(f.answer) }))
  .filter((f: any) => f.answer !== null)
  .map((f: any) => ({ question: f.question.replace('average home price', 'median home price'), answer: cobrand(f.answer) }));
const faqs = [...livingFaqs, ...editorialFaqs] as { question: string; answer: string }[];

const description = `Longboat Key real estate market data from Anne Schneider and Ryan Adamson, Coldwell Banker Realty, St. Armands: ${active.count} active listings, median sold price ${sold.medianPrice} over the last ${sold.windowDays} days, ${mb.monthsOfSupply} months of supply, with Gulf-front, bayfront, condo and single-family segments tracked separately from live Stellar MLS data.`;

const jsonLd = [
  {
    '@type': 'Place',
    name: 'Longboat Key',
    description: media.summary || cobrand(area.description),
    address: { '@type': 'PostalAddress', addressLocality: 'Longboat Key', addressRegion: 'FL', postalCode: '34228', addressCountry: 'US' },
  },
  {
    '@type': 'WebPage',
    name: 'Longboat Key Real Estate Market Guide',
    description,
    url: 'https://longboatlido.com/',
    ...(asOfIso && { dateModified: asOfIso }),
    author: [
      { '@type': 'RealEstateAgent', name: 'Anne Schneider', worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' } },
      { '@type': 'RealEstateAgent', name: 'Ryan Adamson', worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' } },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
];
---

<LLLLayout title="Home" description={description} jsonLd={jsonLd}>

  <section class="gbc-hero">
    <div class="gbc-hero-bg" style="background-image:url('/images/areas/longboat-key.jpg'); background-position:center 40%;"></div>
    <div class="gbc-hero-overlay"></div>
    <div class="relative z-10 container">
      <hr class="gbc-hero-rule" />
      <p class="section-label text-cbgl-blue-light mb-3">Longboat Key &middot; 34228 &middot; Gulf to Bay</p>
      <h1 class="font-display text-white mb-4">Longboat Key, by the numbers</h1>
      <p class="gbc-hero-tag">Every closed sale and every active listing on the island, from live Stellar MLS records: Gulf-front, bayfront, condo and single-family tracked separately, and two agents who work Longboat Key and Lido Key every day.</p>
      <p class="gbc-hero-team">Anne Schneider &amp; Ryan Adamson &middot; Coldwell Banker Realty, St. Armands</p>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        <div>
          <h2 class="accent-underline mb-6">About Longboat Key</h2>
          <p class="gbc-about">{media.summary || cobrand(area.description)}</p>
          {area.highlights && area.highlights.length > 0 && (
            <div class="flex flex-wrap gap-3 mt-6">
              {area.highlights.map((h: string) => <span class="gbc-chip">{h}</span>)}
            </div>
          )}
        </div>
        {media.gallery && media.gallery.length > 0 && (
          <div class="grid grid-cols-2 gap-3 lg:gap-4">
            {media.gallery.map((g: any) => (
              <figure class="gbc-fig">
                <picture>
                  {g.webp && <source srcset={g.webp} type="image/webp" />}
                  <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption class="gbc-fig-cap">{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <p class="section-label text-cbgl-blue-light mb-3">Longboat Key</p>
      <h2 class="font-display mb-3">Market Snapshot</h2>
      <p class="gbc-window">Live Stellar MLS data &middot; closed sales past {sold.windowDays} days &middot; as of {asOf}</p>
      <div class="gbc-stat-grid">
        <div class="gbc-stat"><div class="gbc-stat-value">{active.count}</div><div class="gbc-stat-label">For Sale Today</div><div class="gbc-stat-sub">{stats.counts.pending} more under contract</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{sold.count}</div><div class="gbc-stat-label">Closed Sales</div><div class="gbc-stat-sub">past {sold.windowDays} days</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{sold.medianPrice}</div><div class="gbc-stat-label">Median Sale Price</div><div class="gbc-stat-sub">past {sold.windowDays} days</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{sold.medianDom}</div><div class="gbc-stat-label">Median Days on Market</div><div class="gbc-stat-sub">closed sales, past {sold.windowDays} days</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{sold.saleToListRatio}</div><div class="gbc-stat-label">Median Sale vs. List Price</div><div class="gbc-stat-sub">sale price as % of asking</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{active.medianPrice}</div><div class="gbc-stat-label">Median Asking Price</div><div class="gbc-stat-sub">{active.medianPricePerSqFt} per sq ft, active listings</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{mb.monthsOfSupply}</div><div class="gbc-stat-label">Months of Supply</div><div class="gbc-stat-sub">{mb.label}: condo {mb.monthsOfSupplyCondo}, single-family {mb.monthsOfSupplySfhVilla}</div></div>
        <div class="gbc-stat"><div class="gbc-stat-value">{active.waterfrontCount}</div><div class="gbc-stat-label">Waterfront Listings</div><div class="gbc-stat-sub">{boating?.activeWithDock ?? 0} with a private dock</div></div>
      </div>
      <p class="gbc-note">Months of supply is today&rsquo;s inventory divided by the trailing 12-month closing pace (under 5 favors sellers, over 7 favors buyers).</p>

      <h3 class="font-display gbc-subhead">Condo vs. Single-Family</h3>
      <p class="gbc-window">Two different markets on one island, so we never blend them &middot; closed sales past 12 months and past {cb90?.windowDays ?? 90} days</p>
      <div class="gbc-table-wrap gbc-bld-wrap">
        <table class="gbc-table gbc-bld-table">
          <thead>
            <tr>
              <th>Property Type</th>
              <th class="gbc-num">For Sale</th>
              <th class="gbc-num">Sold, 12 Mo</th>
              <th class="gbc-num">Median Price, 12 Mo</th>
              <th class="gbc-num">Median $ / Sq Ft, 12 Mo</th>
              <th class="gbc-num">Sold, {cb90?.windowDays ?? 90} Days</th>
              <th class="gbc-num">Median Price, {cb90?.windowDays ?? 90} Days</th>
              <th class="gbc-num">Median $ / Sq Ft, {cb90?.windowDays ?? 90} Days</th>
            </tr>
          </thead>
          <tbody>
            {[['Condos, villas &amp; townhouses', 'condo'], ['Single-family homes', 'single_family']].map(([label, key]) => (
              <tr>
                <td class="gbc-bld-id"><span class="gbc-seg" set:html={label}></span></td>
                <td class="gbc-num">{pts?.[key]?.activeCount ?? '&mdash;'}</td>
                <td class="gbc-num">{pts?.[key]?.soldCount ?? '&mdash;'}</td>
                <td class="gbc-num gbc-bld-key">{pts?.[key]?.soldMedianPrice ?? '&mdash;'}</td>
                <td class="gbc-num">{pts?.[key]?.soldMedianPricePerSqFt ?? '&mdash;'}</td>
                <td class="gbc-num">{cb90?.byPropertyType?.[key]?.soldCount ?? '&mdash;'}</td>
                <td class="gbc-num gbc-bld-key">{cb90?.byPropertyType?.[key]?.soldMedianPrice ?? '&mdash;'}</td>
                <td class="gbc-num">{cb90?.byPropertyType?.[key]?.soldMedianPricePerSqFt ?? '&mdash;'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="font-display gbc-subhead">By the Water</h3>
      <p class="gbc-window">Closed sales by waterfront type &middot; past 12 months &middot; Gulf-front and bay-front are priced worlds apart</p>
      <div class="gbc-table-wrap gbc-bld-wrap">
        <table class="gbc-table gbc-bld-table">
          <thead>
            <tr>
              <th>Waterfront</th>
              <th class="gbc-num">For Sale</th>
              <th class="gbc-num">Sold, 12 Mo</th>
              <th class="gbc-num">Median Sale Price</th>
              <th class="gbc-num">Median $ / Sq Ft</th>
            </tr>
          </thead>
          <tbody>
            {segments.map((s) => (
              <tr>
                <td class="gbc-bld-id"><span class="gbc-seg">{s.label}</span>{s.lowSample && <span class="gbc-bld-thin" title="Small sample">*</span>}</td>
                <td class="gbc-num">{s.activeCount}</td>
                <td class="gbc-num">{s.soldCount}</td>
                <td class="gbc-num gbc-bld-key">{s.soldMedianPrice ?? '&mdash;'}</td>
                <td class="gbc-num">{s.soldMedianPricePerSqFt ?? '&mdash;'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {segments.some((s) => s.lowSample) && <p class="gbc-bld-foot">* Small sample. Shown for completeness; read it as a data point, not a trend.</p>}
      </div>

      <div class="gbc-two-col">
        <div>
          <h3 class="font-display gbc-subhead">For Sale by Price Band</h3>
          <p class="gbc-window">Active listings today &middot; where the inventory sits</p>
          <div class="gbc-table-wrap gbc-bld-wrap">
            <table class="gbc-table gbc-bld-table gbc-narrow-table">
              <thead><tr><th>Price Band</th><th class="gbc-num">For Sale</th></tr></thead>
              <tbody>
                <tr><td>Under $900k</td><td class="gbc-num gbc-bld-key">{bands.under900k}</td></tr>
                <tr><td>$900k to $1.5M</td><td class="gbc-num gbc-bld-key">{bands.band900kTo1_5m}</td></tr>
                <tr><td>$1.5M to $3M</td><td class="gbc-num gbc-bld-key">{bands.band1_5mTo3m}</td></tr>
                <tr><td>$3M and above</td><td class="gbc-num gbc-bld-key">{bands.band3mPlus}</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <h3 class="font-display gbc-subhead">Condos by Construction Era</h3>
          <p class="gbc-window">Active condo, villa and townhouse listings grouped by year built</p>
          <div class="gbc-table-wrap gbc-bld-wrap">
            <table class="gbc-table gbc-bld-table gbc-narrow-table">
              <thead><tr><th>Built</th><th class="gbc-num">For Sale</th><th class="gbc-num">Avg Asking</th><th class="gbc-num">Avg $ / Sq Ft</th><th class="gbc-num">Avg Days on Market</th></tr></thead>
              <tbody>
                {tiers.map((t) => (
                  <tr>
                    <td>{t.label}</td>
                    <td class="gbc-num">{t.activeCount}</td>
                    <td class="gbc-num gbc-bld-key">{t.avgPrice ?? '&mdash;'}</td>
                    <td class="gbc-num">{t.avgPricePerSqFt ?? '&mdash;'}</td>
                    <td class="gbc-num">{t.avgDom ?? '&mdash;'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="gbc-bld-foot">Asking prices of current listings, so averages rather than closed-sale medians. Newer eras carry a handful of listings each.</p>
          </div>
        </div>
      </div>

      <h3 class="font-display gbc-subhead">Most Recent Closings</h3>
      <p class="gbc-window">The latest recorded sales on the island, most recent first</p>
      <div class="gbc-table-wrap">
        <table class="gbc-table">
          <thead>
            <tr>
              <th>Address</th>
              <th>Community</th>
              <th>Bed / Bath</th>
              <th class="gbc-num">Sq Ft</th>
              <th class="gbc-num">Sale Price</th>
              <th>Closed</th>
              <th class="gbc-num">Built</th>
              <th>Waterfront</th>
            </tr>
          </thead>
          <tbody>
            {comps.map((c) => (
              <tr>
                <td class="gbc-addr">{c.address}</td>
                <td class="gbc-wv">{c.subdivision || '&mdash;'}</td>
                <td>{c.bedrooms ?? '&mdash;'} / {c.bathrooms ?? '&mdash;'}</td>
                <td class="gbc-num">{c.livingSqFt || '&mdash;'}</td>
                <td class="gbc-num gbc-bld-key">{c.soldPrice}</td>
                <td>{fmtDate(c.soldDate)}</td>
                <td class="gbc-num">{c.yearBuilt ?? '&mdash;'}</td>
                <td class="gbc-wv">{c.isWaterfront ? 'Waterfront' : <span class="gbc-wv-none">Not waterfront</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {condoDues && (
    <section class="section light-section">
      <div class="container-narrow">
        <h2 class="accent-underline mb-3">Typical Condo Dues</h2>
        <p class="gbc-about mb-10">Monthly condo fees for active and recently sold Longboat Key condominiums, villas and townhouses, from the lowest-fee associations to full-service luxury buildings. Median monthly association fee across all listings: {stats.fees.medianMonthlyAssociation}.</p>
        <div class="gbc-dues">
          <div class="text-center mb-12">
            <p class="gbc-dues-eyebrow">Median Monthly Dues</p>
            <p class="gbc-dues-big">{fmtUsd(condoDues.median)}<span class="gbc-dues-unit">/ mo</span></p>
          </div>
          <div class="relative pt-7 pb-1">
            <div class="absolute top-0 -translate-x-1/2 whitespace-nowrap" style={`left: ${duesPct}%;`}>
              <span class="gbc-dues-tick">Median</span>
            </div>
            <div class="gbc-dues-track">
              <div class="gbc-dues-fill"></div>
              <div class="gbc-dues-knob" style={`left: ${duesPct}%;`}></div>
            </div>
            <div class="flex justify-between mt-5">
              <div class="text-left"><p class="gbc-dues-eyebrow">Minimum</p><p class="gbc-dues-end">{fmtUsd(condoDues.min)}<span class="gbc-dues-unit">/ mo</span></p></div>
              <div class="text-right"><p class="gbc-dues-eyebrow">Maximum</p><p class="gbc-dues-end">{fmtUsd(condoDues.max)}<span class="gbc-dues-unit">/ mo</span></p></div>
            </div>
          </div>
        </div>
        <p class="gbc-dues-foot">Source: Stellar MLS. Monthly condo dues only; entries under $100/mo are treated as data-entry errors and omitted. Figures are approximate and vary by building, square footage and amenities.</p>
      </div>
    </section>
  )}

  <IdxAreaShowcase
    widgetId={area.idxWidgetId}
    areaName="Longboat Key"
    label="Available Now"
    showOffMarketCta={false}
  />

  <section class="section light-section">
    <div class="container">
      <p class="section-label mb-3">Neighborhood Pages</p>
      <h2 class="accent-underline mb-6">Longboat Key, Neighborhood by Neighborhood</h2>
      <p class="gbc-about mb-8">Island-wide numbers tell you the direction. Neighborhood pages tell you what your street is worth. Each one tracks every closed sale in that community from the MLS, segment by segment.</p>
      <div class="gbc-comm-grid">
        <a href="/country-club-shores/" class="gbc-comm-card">
          <p class="gbc-comm-eyebrow">Longboat Key &middot; 34228 &middot; Canal-Front</p>
          <h3 class="gbc-comm-title">Country Club Shores</h3>
          <p class="gbc-comm-copy">Closed-sale data for the canal-front neighborhood on the south end of Longboat Key: canal-front, open-bayfront and interior homes tracked separately, with price per square foot, days on market and sale-to-list ratios.</p>
          <p class="gbc-comm-cta">See the numbers &rarr;</p>
        </a>
        <!-- Next community cards land here as Longboat / Lido neighborhood pages come online. -->
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section dark-section">
      <div class="container-narrow">
        <p class="section-label text-cbgl-blue-light mb-3">Straight Answers</p>
        <h2 class="font-display mb-8">Longboat Key Market Questions</h2>
        <div class="gbc-faq">
          {faqs.map((f) => (
            <details class="gbc-faq-item">
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="section light-section">
    <div class="container">
      <p class="section-label mb-3">Two Ways In</p>
      <h2 class="accent-underline mb-6">Work With Us on Longboat Key</h2>
      <div class="gbc-tiles">
        <div class="gbc-tile gbc-tile-seller">
          <span class="gbc-tile-eyebrow">For Owners</span>
          <h3 class="gbc-tile-title">Reach out for a private consult</h3>
          <p class="gbc-tile-copy">Curious what your home or condo would bring today? We&rsquo;ll walk the real closed-sale data above against your building, view, floor and condition. Gulf-front, bayfront, condo and single-family are different markets, and we price them that way. Privately, with no obligation and no listing pressure.</p>
          <form class="gbc-form" data-lead-type="Seller" data-community="Longboat Key"
                name="home-lead-seller" method="POST" action="/thank-you/" data-team="Anne &amp; Ryan" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="home-lead-seller" />
            <input type="hidden" name="lead_type" value="Seller" />
            <input type="hidden" name="community" value="Longboat Key" />
            <p class="gbc-hp"><label>Don&rsquo;t fill this out: <input name="bot-field" /></label></p>
            <div class="gbc-field"><label for="s-name-lbk">Name</label>
              <input id="s-name-lbk" name="name" type="text" required autocomplete="name" /></div>
            <div class="gbc-field"><label for="s-email-lbk">Email</label>
              <input id="s-email-lbk" name="email" type="email" required autocomplete="email" /></div>
            <div class="gbc-field"><label for="s-phone-lbk">Phone</label>
              <input id="s-phone-lbk" name="phone" type="tel" autocomplete="tel" /></div>
            <div class="gbc-field"><label for="s-notes-lbk">Other details you&rsquo;d like to share <span class="gbc-optional">optional</span></label>
              <textarea id="s-notes-lbk" name="notes" rows="3" maxlength="1200"
                        placeholder="Building or street, view, updates you&rsquo;ve made, timing you have in mind"></textarea></div>
            <button type="submit" class="gbc-btn gbc-btn-gold gbc-btn-full">Request a Private Consult</button>
            <p class="gbc-form-status" data-out="status" role="status" aria-live="polite"></p>
          </form>
        </div>
        <div class="gbc-tile gbc-tile-buyer">
          <span class="gbc-tile-eyebrow">For Buyers</span>
          <h3 class="gbc-tile-title">Add me to the coming-soon list</h3>
          <p class="gbc-tile-copy">The best Gulf-front and bayfront residences on Longboat Key often change hands before they reach the MLS. Tell us what you are looking for and we&rsquo;ll reach out first on available and off-market homes.</p>
          <form class="gbc-form" data-lead-type="Buyer" data-community="Longboat Key"
                name="home-lead-buyer" method="POST" action="/thank-you/" data-team="Anne &amp; Ryan" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="home-lead-buyer" />
            <input type="hidden" name="lead_type" value="Buyer" />
            <input type="hidden" name="community" value="Longboat Key" />
            <p class="gbc-hp"><label>Don&rsquo;t fill this out: <input name="bot-field" /></label></p>
            <div class="gbc-field"><label for="b-name-lbk">Name</label>
              <input id="b-name-lbk" name="name" type="text" required autocomplete="name" /></div>
            <div class="gbc-field"><label for="b-email-lbk">Email</label>
              <input id="b-email-lbk" name="email" type="email" required autocomplete="email" /></div>
            <div class="gbc-field"><label for="b-phone-lbk">Phone</label>
