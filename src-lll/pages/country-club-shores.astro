---
// Country Club Shores, Longboat Key : community landing page (Adamson x Schneider).
// Modeled on gulf-and-bay-club-beachfront.astro; data baked from Supabase MLS snapshot 2026-08-27.
// Re-bake the numbers before season; hand edits to copy are fine.
import LLLLayout from '../layouts/LLLLayout.astro';
import IdxAreaShowcase from '@/components/IdxAreaShowcase.astro';

const description = 'Country Club Shores, Longboat Key (34228) single-family market: 20 closed sales in the last 180 days, average $3,136,500, with canal-front, open-bayfront and interior homes tracked separately, plus price per sqft, days on market and sale-to-list ratios from live Stellar MLS data.';

const jsonLd = [
  {
    '@type': 'Place',
    name: 'Country Club Shores',
    description: 'A canal-front single-family neighborhood on the south end of Longboat Key, with deep-water canals off Sarasota Bay and the Longboat Key Club across Gulf of Mexico Drive.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Longboat Key',
      addressRegion: 'FL',
      postalCode: '34228',
      addressCountry: 'US',
    },
  },
  {
    '@type': 'WebPage',
    name: 'Country Club Shores Home Sales, Longboat Key',
    description: description,
    url: 'https://longboatlido.com/country-club-shores',
    dateModified: '2026-08-27',
    author: [
      {
        '@type': 'RealEstateAgent',
        name: 'Anne Schneider',
        worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' },
      },
      {
        '@type': 'RealEstateAgent',
        name: 'Ryan Adamson',
        worksFor: { '@type': 'Organization', name: 'Coldwell Banker Realty, St. Armands' },
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How much of Country Club Shores is canal-front?', acceptedAnswer: { '@type': 'Answer', text: 'Most of the neighborhood sits on deep-water canals: 22 of the 25 single-family closings in the 12 months ending August 27, 2026 were canal-front homes, with a small number of open-bayfront point lots and interior homes along Gulf of Mexico Drive.' } },
      { '@type': 'Question', name: 'What does a canal-front home in Country Club Shores sell for?', acceptedAnswer: { '@type': 'Answer', text: 'Canal-front homes closed at a median of $2,750,000 over the 12 months ending August 27, 2026, while the rare open-bayfront homes commanded far more. See the on-page table for the full segment breakdown.' } }
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://longboatlido.com/' },
      { '@type': 'ListItem', position: 2, name: 'Country Club Shores', item: 'https://longboatlido.com/country-club-shores' },
    ],
  },
];
---

<LLLLayout title='Country Club Shores' description={description} jsonLd={jsonLd}>

  <section class="gbc-hero gbc-hero--video">
    <div class="gbc-hero-bg">
      <!-- HERO PLACEHOLDER: drop the aerial at /public/videos/country-club-shores.mp4
           and a poster frame at /public/videos/country-club-shores-poster.jpg -->
      <video
        class="gbc-hero-video"
        autoplay muted loop playsinline
        preload="metadata"
        poster="/videos/country-club-shores-poster.jpg"
        aria-hidden="true" tabindex="-1">
        <source src="/videos/country-club-shores.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="gbc-hero-overlay"></div>
    <div class="relative z-10 container">
      <hr class="gbc-hero-rule" />
      <p class="section-label text-cbgl-blue-light mb-3">Longboat Key &middot; 34228 &middot; Canal-Front</p>
      <h1 class="font-display text-white mb-4">Country Club Shores</h1>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        <div>
          <h2 class="accent-underline mb-6">About Country Club Shores</h2>
          <p class="gbc-about">Country Club Shores is the south end of Longboat Key&rsquo;s signature canal neighborhood: four sections of single-family homes laid out in the late 1950s and 1960s on streets named for golf and sailing, from Putter and Birdie Lane to Ketch, Sloop and Halyard. Nearly every home backs to a deep-water canal off Sarasota Bay, minutes by boat to New Pass and the Gulf, with the Longboat Key Club&rsquo;s fairways just across Gulf of Mexico Drive and St. Armands Circle a five-minute drive south. The housing stock runs from original ranch homes on wide canal lots to brand-new coastal construction, which is exactly what makes the market here worth tracking closely. This page follows the real closed-sale market, straight from the MLS, with canal-front, open-bayfront and interior homes broken out separately.</p>
          <div class="flex flex-wrap gap-3 mt-6">
            <span class="gbc-chip">Deep-Water Canals</span>
            <span class="gbc-chip">Minutes to New Pass</span>
            <span class="gbc-chip">Single-Family Only</span>
            <span class="gbc-chip">Golf Across the Street</span>
            <span class="gbc-chip">5 Min to St. Armands</span>
            <span class="gbc-chip">No HOA Towers</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 lg:gap-4">
          <!-- PHOTO PLACEHOLDERS: replace each .ccs-ph block with a <picture> like the G&B page
               once Country Club Shores photography is shot. -->
          <figure class="gbc-fig"><div class="ccs-ph"><span>Canal &amp; dock photo</span></div></figure>
          <figure class="gbc-fig"><div class="ccs-ph"><span>Aerial of the four sections</span></div></figure>
          <figure class="gbc-fig"><div class="ccs-ph"><span>New construction photo</span></div></figure>
          <figure class="gbc-fig"><div class="ccs-ph"><span>Bayfront point lot photo</span></div></figure>
          <figure class="gbc-fig gbc-fig-wide"><div class="ccs-ph"><span>Wide aerial &mdash; canals to the bay</span></div></figure>
        </div>
      </div>
    </div>
  </section>

